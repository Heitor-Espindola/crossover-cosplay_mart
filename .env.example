# Variáveis de ambiente — copie para `.env` e preencha
# (no Railway, cole cada uma em Variables; não precisa de arquivo)

# ── Banco de dados (Turso) ──────────────────────────────────────────────
# Sem estas duas variáveis o app usa um SQLite local em server/data/crossover.sqlite
TURSO_DATABASE_URL=libsql://seu-banco-sua-conta.turso.io
TURSO_AUTH_TOKEN=

# ── Segurança ───────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Servidor ────────────────────────────────────────────────────────────
# O Railway define PORT sozinho; deixe vazio lá.
PORT=4000
NODE_ENV=production

# Opcional: libera CORS para outro domínio (ex.: um preview externo).
# Com o app servindo o site e a API no mesmo domínio, não é necessário.
# ALLOWED_ORIGIN=https://crossover.com.br

# Opcional: loga cada requisição no console (útil para depurar)
# DEBUG_REQ=1
